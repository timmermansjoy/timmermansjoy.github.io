---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/shared/Logo.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Not found — Joy Timmermans" description="The page you were looking for does not exist.">
  <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
    <a href="/" class="flex items-center gap-2.5">
      <Logo size={26} alt={`${profile.name} home`} />
      <span class="text-sm font-medium tracking-tight">{profile.name}</span>
    </a>
  </header>
  <main class="mx-auto max-w-3xl px-6 pb-24">
    <section class="pt-24">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Not found</h1>
      <p class="mt-3 max-w-md text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-400">
        That page doesn't exist. Head back home, or browse the blog.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <a href="/" class="font-medium text-neutral-900 underline-offset-4 hover:underline dark:text-neutral-100">Home →</a>
        <a href="/blog" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">Blog</a>
      </div>
    </section>
  </main>
</BaseLayout>
