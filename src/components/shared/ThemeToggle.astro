---
/*
  Color-mode toggle button. Cycles light <-> dark, persists in localStorage,
  and updates the `.dark` class on <html>. Script is inline so it runs without
  hydration, but is scoped to this component's markup.
*/
const classBase =
  'inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors hover:text-[#8a3a14] dark:hover:text-[#e07a3e]';
---

<button
  type="button"
  class:list={['jt-theme-toggle', classBase]}
  aria-label="Toggle color mode"
  title="Toggle color mode"
  data-theme-toggle
>
  <svg
    class="jt-icon-sun h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="jt-icon-moon h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .jt-theme-toggle .jt-icon-moon {
    display: none;
  }
  .jt-theme-toggle .jt-icon-sun {
    display: block;
  }
  :global(.dark) .jt-theme-toggle .jt-icon-moon {
    display: block;
  }
  :global(.dark) .jt-theme-toggle .jt-icon-sun {
    display: none;
  }
</style>

<script>
  const btn = document.querySelector('[data-theme-toggle]');
  if (btn) {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('jt-theme', isDark ? 'dark' : 'light');
      } catch (e) {
        /* ignore */
      }
    });
  }
</script>
