---
import { impact } from '../../data/impact';

const fmt = (n: number, decimals: number) =>
  n.toLocaleString('en', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  });
---

<section id="impact" class="scroll-mt-24 border-t border-[#d9cdb4] py-16 dark:border-[#3a3122]">
  <p class="text-xs uppercase tracking-[0.2em] text-[#9a8b6c] dark:text-[#7a6e55]" data-reveal>
    Selected numbers
  </p>

  <ul class="mt-8 grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-3">
    {
      impact.map((m, i) => (
        <li class="border-t border-[#e3d9c0] pt-4 dark:border-[#2e281d]" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <p class="font-serif text-5xl font-light leading-none tracking-tight text-[#211b12] dark:text-[#ece2cf] sm:text-6xl">
            {m.prefix ?? ''}{fmt(m.value, m.decimals ?? 0)}{m.suffix ?? ''}
          </p>
          <p class="mt-3 text-sm font-medium text-[#3a3122] dark:text-[#cfc2a7]">{m.label}</p>
          <p class="mt-0.5 text-xs italic text-[#9a8b6c] dark:text-[#7a6e55]">{m.context}</p>
        </li>
      ))
    }
  </ul>
</section>
