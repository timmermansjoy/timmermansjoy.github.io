---
import { featured } from '../../data/featured';
---

<section id="featured" class="scroll-mt-24 border-t border-[#d9cdb4] py-16 dark:border-[#3a3122]">
  <div class="grid gap-8 sm:grid-cols-12 sm:items-start">
    <div class="sm:col-span-7">
      <p class="text-xs uppercase tracking-[0.2em] text-[#9a8b6c] dark:text-[#7a6e55]" data-reveal>
        {featured.kicker}
      </p>
      <h2 class="mt-4 font-serif text-5xl font-light tracking-tight sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
        {featured.title}
      </h2>
      <div class="mt-7 space-y-5 text-[17px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]" data-reveal style="--reveal-delay: 160ms">
        {featured.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="mt-10 grid grid-cols-3 gap-x-6 gap-y-6" data-reveal style="--reveal-delay: 240ms">
        {
          featured.metrics.map((m) => (
            <li class="border-t border-[#e3d9c0] pt-3 dark:border-[#2e281d]">
              <p class="font-serif text-3xl font-light leading-none tracking-tight text-[#211b12] dark:text-[#ece2cf] sm:text-4xl">{m.value}</p>
              <p class="mt-2 text-xs italic text-[#9a8b6c] dark:text-[#7a6e55]">{m.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="sm:col-span-5" data-reveal style="--reveal-delay: 200ms">
      {featured.image && (
        <img
          src={featured.image}
          alt={featured.imageAlt ?? featured.title}
          width="400"
          height="500"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full rounded-md border border-[#d9cdb4] object-cover grayscale-[0.1] dark:border-[#3a3122]"
          data-fallback-src="/images/placeholder.svg"
        />
      )}
    </div>
  </div>
</section>
