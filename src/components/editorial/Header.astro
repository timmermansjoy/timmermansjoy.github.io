---
import Logo from '../shared/Logo.astro';
import ThemeToggle from '../shared/ThemeToggle.astro';
import { profile } from '../../data/profile';

const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog');
const isAbout = path.startsWith('/about');

const linkBase = 'text-sm transition-colors';
const linkIdle = 'text-[#5a4e36] hover:text-[#8a3a14] dark:text-[#b8a987] dark:hover:text-[#e07a3e]';
const linkActive = 'text-[#8a3a14] dark:text-[#e07a3e] font-medium';
---

<header class="sticky top-0 z-40 border-b border-[#d9cdb4] bg-[#f6efe1]/80 backdrop-blur-md dark:border-[#3a3122] dark:bg-[#17120b]/80">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${profile.name} — home`}>
      <Logo size={26} alt={`${profile.name} home`} />
      <span class="font-serif text-base italic tracking-tight">{profile.name}</span>
    </a>
    <nav class="flex items-center gap-6" aria-label="Primary">
      <a href="/blog" class:list={[linkBase, isBlog ? linkActive : linkIdle]}>Blog</a>
      <a href="/about" class:list={[linkBase, isAbout ? linkActive : linkIdle]}>About</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
