---
import Section from './Section.astro';
import { experience } from '../../data/experience';
---

<Section id="experience" title="Work" index="02">
  <div class="divide-y divide-[#e3d9c0] dark:divide-[#2e281d]">
    {
      experience.map((role, i) => (
        <article class="py-8 first:pt-0 last:pb-0" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-serif text-2xl tracking-tight">{role.company}</h3>
            <p class="font-mono text-xs text-[#9a8b6c] dark:text-[#7a6e55]">{role.period}</p>
          </div>
          <p class="mt-1 text-sm italic text-[#5a4e36] dark:text-[#b8a987]">{role.title} · {role.location}</p>

          {role.narrative && (
            <p class="mt-4 text-[17px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]">
              {role.narrative}
            </p>
          )}

          {role.clients && (
            <div class="mt-6 space-y-6 border-l border-[#d9cdb4] pl-6 dark:border-[#3a3122]">
              {role.clients.map((client) => (
                <div>
                  <h4 class="font-serif text-xl tracking-tight">
                    {client.href ? (
                      <a href={client.href} class="link-underline hover:text-[#8a3a14] dark:hover:text-[#e07a3e]">{client.name}</a>
                    ) : (
                      client.name
                    )}
                  </h4>
                  {client.narrative && (
                    <p class="mt-2 text-[16px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]">
                      {client.narrative}
                    </p>
                  )}
                </div>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</Section>
