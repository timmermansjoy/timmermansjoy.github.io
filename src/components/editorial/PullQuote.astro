---
interface Props {
  quote?: string;
}
const {
  quote = 'Everything should be as simple as possible, but not simpler.',
} = Astro.props;
---

<figure class="relative mx-auto my-20 max-w-3xl px-2 text-center" data-reveal>
  <span aria-hidden="true" class="font-serif text-7xl leading-none text-[#8a3a14] dark:text-[#e07a3e]">“</span>
  <blockquote class="-mt-6 font-serif text-3xl font-light leading-snug tracking-tight text-[#211b12] dark:text-[#ece2cf] sm:text-4xl">
    {quote}
  </blockquote>
  <figcaption class="mt-6 text-xs uppercase tracking-[0.2em] text-[#9a8b6c] dark:text-[#7a6e55]">
    — Albert Einstein
  </figcaption>
</figure>
