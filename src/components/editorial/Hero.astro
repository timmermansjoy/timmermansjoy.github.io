---
import Logo from '../shared/Logo.astro';
import { profile } from '../../data/profile';
---

<section class="relative overflow-hidden py-16 sm:py-24">
  <div class="grid gap-10 sm:grid-cols-12 sm:items-start">
    <div class="sm:col-span-7">
      <div class="flex items-end gap-5" data-reveal style="--reveal-delay: 0ms">
        <a href="/" class="block shrink-0 transition-transform duration-300 hover:-rotate-2 hover:scale-[1.02]" aria-label={`${profile.name} — home`}>
          <Logo size={112} trace />
        </a>
        <div class="pb-2">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#9a8b6c] dark:text-[#7a6e55]">Personal blog</p>
          <p class="mt-2 text-sm text-[#5a4e36] dark:text-[#b8a987]">{profile.location}</p>
        </div>
      </div>

      <p class="mt-10 font-serif text-2xl font-light italic leading-snug tracking-tight text-[#211b12] dark:text-[#ece2cf] sm:text-3xl" data-reveal style="--reveal-delay: 120ms">
        I build computer-vision things that usually end up running somewhere awkward: tiny devices, odd camera angles, patchy Wi-Fi, real people waiting for the thing to just work. I like the simplest version that actually solves the problem — the one that stays contained and does not grow into a framework.
      </p>

      <h1 class="mt-10 font-serif text-6xl font-light leading-[0.95] tracking-tight sm:text-7xl" data-reveal style="--reveal-delay: 240ms">
        {profile.name}
      </h1>
      <p class="mt-4 font-serif text-xl italic text-[#5a4e36] dark:text-[#b8a987] sm:text-2xl" data-reveal style="--reveal-delay: 360ms">
        {profile.title}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2 text-sm" data-reveal style="--reveal-delay: 480ms">
        <a class="link-underline font-medium text-[#211b12] hover:text-[#8a3a14] dark:text-[#ece2cf] dark:hover:text-[#e07a3e]" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="link-underline text-[#5a4e36] hover:text-[#8a3a14] dark:text-[#b8a987] dark:hover:text-[#e07a3e]" href={profile.github}>GitHub</a>
        <a class="link-underline text-[#5a4e36] hover:text-[#8a3a14] dark:text-[#b8a987] dark:hover:text-[#e07a3e]" href={profile.linkedin}>LinkedIn</a>
      </div>
    </div>

    <div class="sm:col-span-5" data-reveal style="--reveal-delay: 200ms">
      <img
        src="/images/portrait.jpg"
        alt={`Portrait of ${profile.name}`}
        width="480"
        height="600"
        loading="eager"
        decoding="async"
        class="aspect-[4/5] w-full rounded-md border border-[#d9cdb4] object-cover grayscale-[0.1] dark:border-[#3a3122]"
        data-fallback-src="/images/placeholder.svg"
      />
    </div>
  </div>
</section>
