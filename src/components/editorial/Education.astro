---
import Section from './Section.astro';
import { education } from '../../data/education';
---

<Section id="education" title="Education" index="03">
  <div class="space-y-10">
    {
      education.map((item, i) => (
        <article data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-serif text-2xl tracking-tight">{item.school}</h3>
            <p class="text-sm text-[#9a8b6c] dark:text-[#7a6e55]">{item.period}</p>
          </div>
          <p class="mt-1 text-sm italic text-[#5a4e36] dark:text-[#b8a987]">{item.degree} · {item.location}</p>
          <dl class="mt-4 space-y-3 text-[16px] text-[#3a3122] dark:text-[#cfc2a7]">
            {item.notes.map((note) => (
              <div class="grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-[10rem_1fr]">
                <dt class="text-sm italic text-[#9a8b6c] dark:text-[#7a6e55]">{note.label}</dt>
                <dd>{note.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))
    }
  </div>
</Section>
