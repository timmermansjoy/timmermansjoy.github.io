---
import Section from './Section.astro';
import { openSource } from '../../data/opensource';
import { languages } from '../../data/languages';
---

<Section id="community" title="Community" index="06">
  <div class="space-y-8">
    {
      openSource.map((item, i) => (
        <article data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <h3 class="font-serif text-xl tracking-tight">{item.name}</h3>
          <p class="mt-2 text-[16px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]">{item.description}</p>
          {item.href && (
            <a href={item.href} class="link-underline mt-2 inline-block text-sm font-medium text-[#8a3a14] dark:text-[#e07a3e]">Link →</a>
          )}
        </article>
      ))
    }
  </div>
</Section>

<Section id="languages" title="Languages" index="07">
  <ul class="space-y-2 text-[16px] text-[#3a3122] dark:text-[#cfc2a7]">
    {
      languages.map((lang) => (
        <li class="flex items-baseline gap-5">
          <span class="w-28 text-sm italic text-[#9a8b6c] dark:text-[#7a6e55]">{lang.name}</span>
          <span>{lang.level}</span>
        </li>
      ))
    }
  </ul>
</Section>
