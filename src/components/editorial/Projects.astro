---
import Section from './Section.astro';
import { projects } from '../../data/projects';
---

<Section id="projects" title="Selected Projects" index="04">
  <div class="space-y-12">
    {
      projects.map((project, i) => (
        <article class="grid gap-5 sm:grid-cols-12 sm:items-start" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          {project.image && (
            <div class="sm:col-span-5">
              <img
                src={project.image}
                alt={project.imageAlt ?? project.name}
                width="400"
                height="300"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-md border border-[#d9cdb4] object-cover grayscale-[0.1] dark:border-[#3a3122]"
                data-fallback-src="/images/placeholder.svg"
              />
            </div>
          )}
          <div class={project.image ? 'sm:col-span-7' : 'sm:col-span-12'}>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="font-mono text-xs text-[#9a8b6c] dark:text-[#7a6e55]">0{i + 1}</span>
              <h3 class="font-serif text-2xl tracking-tight">{project.name}</h3>
              <p class="ml-auto text-sm italic text-[#9a8b6c] dark:text-[#7a6e55]">{project.tag}</p>
            </div>
            <p class="mt-3 text-[16px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]">
              {project.description}
            </p>
            {project.href && (
              <a href={project.href} class="link-underline group mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-[#8a3a14] dark:text-[#e07a3e]">
                View on GitHub
                <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
