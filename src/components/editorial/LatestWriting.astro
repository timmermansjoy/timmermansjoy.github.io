---
import Section from './Section.astro';
import { getCollection } from 'astro:content';


const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lead = posts[0];
const rest = posts.slice(1, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Section id="blog" title="Blog" index="01">
  {posts.length === 0 ? (
    <p class="text-sm italic text-[#9a8b6c] dark:text-[#7a6e55]">No posts yet — check back soon.</p>
  ) : (
    <div class="space-y-10">
      {/* Lead post */}
      {lead && (
        <article class="border-t border-[#d9cdb4] pt-6 dark:border-[#3a3122]" data-reveal>
          <p class="font-mono text-xs text-[#9a8b6c] dark:text-[#7a6e55]">
            <time datetime={lead.data.pubDate.toISOString()}>{fmt(lead.data.pubDate)}</time>
            {lead.data.tags.length > 0 && <span class="ml-3">· {lead.data.tags.join(' / ')}</span>}
          </p>
          <h3 class="mt-3 font-serif text-3xl font-light tracking-tight sm:text-4xl">
            <a href={`/blog/${lead.id.replace(/\.mdx?$/, '')}/`} class="link-underline hover:text-[#8a3a14] dark:hover:text-[#e07a3e]">{lead.data.title}</a>
          </h3>
          <p class="mt-3 text-[17px] leading-relaxed text-[#3a3122] dark:text-[#cfc2a7]">{lead.data.description}</p>
          <a href={`/blog/${lead.id.replace(/\.mdx?$/, '')}/`} class="link-underline group mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[#8a3a14] dark:text-[#e07a3e]">
            Read
            <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
          </a>
        </article>
      )}

      {/* Recent list */}
      {rest.length > 0 && (
        <ul class="space-y-5">
          {rest.map((post, i) => (
            <li class="border-t border-[#e3d9c0] pt-4 dark:border-[#2e281d]" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`} class="group block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="font-serif text-xl tracking-tight group-hover:text-[#8a3a14] dark:group-hover:text-[#e07a3e]">{post.data.title}</h4>
                  <time class="font-mono text-xs text-[#9a8b6c] dark:text-[#7a6e55]" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                </div>
                <p class="mt-1 text-[15px] leading-relaxed text-[#5a4e36] dark:text-[#b8a987]">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}

      <a href="/blog" class="link-underline group inline-flex items-center gap-1.5 text-sm font-medium text-[#8a3a14] dark:text-[#e07a3e]">
        All posts
        <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  )}
</Section>
